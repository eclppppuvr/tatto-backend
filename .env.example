# Скопируйте в .env (файл в .gitignore) и заполните.
DB_URL=postgresql+psycopg://tattoo:tattoo@localhost:5432/tattoo
# Не короче 32 символов, например: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000

# Очередь и прогресс (Celery + Redis pub/sub)
REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=            # по умолчанию = REDIS_URL

# Хранилище (MinIO/S3)
S3_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tattoo

# AI-движок: пока только stub (OpenCV/Yandex/SD появятся в TB-03/04/05)
AI_ENGINE=stub
